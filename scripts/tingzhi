#!/bin/bash
# Stop the conveyor and every Dofbot runtime process.

set -euo pipefail

RUNTIME_COMMON="$HOME/runtime_common.sh"

if [ ! -f "$RUNTIME_COMMON" ]; then
    echo "[运行保护][错误] 未找到 $RUNTIME_COMMON" >&2
    exit 1
fi
source "$RUNTIME_COMMON"

runtime_transition_begin "独立停止传送带"
trap runtime_transition_end EXIT
runtime_stop_and_cleanup "停止传送带前"
echo "[完成] 传送带和全部项目节点均已停止"
