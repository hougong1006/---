#!/bin/bash
# Stop every previous mode, then send one conveyor START pulse only.

set -euo pipefail

RUNTIME_COMMON="$HOME/runtime_common.sh"

if [ ! -f "$RUNTIME_COMMON" ]; then
    echo "[运行保护][错误] 未找到 $RUNTIME_COMMON" >&2
    exit 1
fi
source "$RUNTIME_COMMON"

runtime_transition_begin "独立启动传送带"
trap runtime_transition_end EXIT
runtime_stop_and_cleanup "启动传送带前"
runtime_send_start_pulse
echo "[传送带] 仅启动传送带，机械臂、ROS、相机和分拣程序保持停止"
